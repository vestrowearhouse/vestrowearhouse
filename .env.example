# StellarMartBD — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git — it is in .gitignore.
# For production (Vercel): add these in the Vercel dashboard under
#   Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════
# SECURITY (Required — set strong random values)
# ══════════════════════════════════════════════

# JWT signing secret — MUST be at least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_long_random_secret_min_32_chars_change_this

# CSRF double-submit secret (optional — used for extra CSRF signing if needed)
CSRF_SECRET=another_random_secret_for_csrf_protection_change_this

# ══════════════════════════════════════════════
# FIREBASE (Required for Auth)
# ══════════════════════════════════════════════
# Get from Firebase Console → Project Settings → General → Your apps → Web app

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef1234567890

# Firebase Admin Service Account (server-side only)
# Download JSON from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ══════════════════════════════════════════════
# SUPABASE
# ══════════════════════════════════════════════
# Get from Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ══════════════════════════════════════════════
# EMAIL
# ══════════════════════════════════════════════
# Resend (https://resend.com) — recommended for transactional email
RESEND_API_KEY=re_your_resend_api_key_here

# OR Zoho Mail
ZOHO_MAIL_USER=support@yourdomain.com
ZOHO_MAIL_PASS=your_zoho_app_password

# ══════════════════════════════════════════════
# AI (Google Gemini)
# ══════════════════════════════════════════════
GEMINI_API_KEY=your_gemini_api_key

# ══════════════════════════════════════════════
# CLOUDINARY (Image Upload)
# ══════════════════════════════════════════════
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ══════════════════════════════════════════════
# APP URLs
# ══════════════════════════════════════════════
NEXT_PUBLIC_API_URL=http://localhost:3000
# For production: NEXT_PUBLIC_API_URL=https://stellarmartbd.com

# Comma-separated extra allowed CORS origins (optional)
# CORS_ALLOWED_ORIGINS=https://your-other-domain.com

# ══════════════════════════════════════════════
# RATE LIMITING (optional — Upstash Redis for global limiting)
# ══════════════════════════════════════════════
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token